# Public reference only: this app does not read .env files.
# Inject APP_PASSWORD and AI_API_KEY as environment secrets, never in any file.
# Set every AI variable in Railway Variables or your process environment.
AI_BASE_URL=https://integrate.api.nvidia.com/v1
AI_MODEL=meta/llama-3.3-70b-instruct

# Optional comma-separated hostnames for your authenticated reverse proxy.
# Localhost, 127.0.0.1, ::1, and terminal.local work by default.
# APP_ALLOWED_HOSTS=tasks.example.com

# Local npm start options. Docker Compose sets these separately.
HOST=127.0.0.1
PORT=3000
# Optional storage directory; defaults to this application's data/ directory.
# DATA_DIR=/absolute/path/to/persistent-data
