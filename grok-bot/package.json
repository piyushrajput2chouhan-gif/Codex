{
  "name": "orbit-task-assistant",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": { "node": ">=24.15.0" },
  "scripts": {
    "dev": "node --use-env-proxy scripts/dev.mjs",
    "build": "vite build",
    "start": "node --use-env-proxy server/index.mjs",
    "check:ai": "node --use-env-proxy scripts/check-ai.mjs",
    "ready": "npm run check:ai && npm run dev -- --host 0.0.0.0 --port 4173 --strictPort",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {},
  "devDependencies": {
    "@phosphor-icons/core": "2.1.1",
    "vite": "8.3.4"
  }
}
